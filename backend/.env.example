# Copy this file to .env and fill in real values. NEVER commit .env.

ENVIRONMENT=development

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# This matches the local Docker database in docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://flowsaic:flowsaic_dev@localhost:5433/flowsaic

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Gemini (AI suggest + RAG embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Data retrieval (optional; these are the defaults, see AGENTS.md "Data sources and refresh")
# CATALOG_CATOID=10                  # SAU catalog id: 10 = 2026-27 undergraduate
# CATALOG_MIN_DELAY_SECONDS=120      # catalog.saumag.edu robots.txt asks for 120 s
# COURSE_INFO_CRAWL=false            # true = re-crawl course pages (a new catalog year)
# DEGREE_MAPS_DELAY_SECONDS=30       # seconds between www.saumag.edu program pages
# PUBLIC_REFRESH_ON_STARTUP=true
# PUBLIC_REFRESH_MAX_AGE_DAYS=7

# React front end (optional; this is the default). Comma-separated origins allowed to call the
# API with the session cookie. Never "*". The Vite dev proxy (/api) doesn't need it.
# FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
