# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Data — never commit real or dumped data
*.sql.gz
*.dump
*.sqlite
*.db
data/private/
# Degree audits and other PDFs can hold student records. The app never writes them to disk.
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
